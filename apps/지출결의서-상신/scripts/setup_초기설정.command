#!/bin/bash

# 더블클릭 시 파일이 위치한 폴더를 기준점으로 잡아 안전하게 실행되도록 설정
cd "$(dirname "$0")"

echo "========================================================="
echo "📦 런드리고 지출결의서 봇 초기 환경 세팅을 시작합니다..."
echo "========================================================="
echo ""

# 1. 필수 외부 라이브러리 설치
echo "1/2. 봇 구동을 위한 필수 파이썬 라이브러리를 설치합니다..."
pip3 install gspread google-auth-oauthlib python-dotenv playwright

echo ""

# 2. 크로미움 등 Playwright 백그라운드 브라우저 구동 바이너리 설치
echo "2/2. Playwright 전용 브라우저 바이너리 다운로드 중..."
playwright install

echo ""
echo "========================================================="
echo "✅ 모든 설치가 완벽하게 완료되었습니다."
echo "이제 'run_봇구동.command' 파일을 더블클릭해서 봇을 시작하세요!"
echo "(이 창을 닫으시려면 아무 키나 누르세요...)"
echo "========================================================="

# 대기 후 종료
read -n 1 -s
